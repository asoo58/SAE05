{% extends 'base.html.twig' %}

{% block title %}Tournées organisées{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset('css/tournees.css') }}">
{% endblock %}

{% block body %}
    <div class="tournees-page tournees-page--liste">
        <section class="tournees-hero rounded-4 p-4 p-lg-5 mb-4">
            <div class="d-flex align-items-start gap-3 position-relative" style="z-index: 1;">
                <span class="hero-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="8" y1="6" x2="21" y2="6"></line>
                        <line x1="8" y1="12" x2="21" y2="12"></line>
                        <line x1="8" y1="18" x2="21" y2="18"></line>
                        <line x1="3" y1="6" x2="3.01" y2="6"></line>
                        <line x1="3" y1="12" x2="3.01" y2="12"></line>
                        <line x1="3" y1="18" x2="3.01" y2="18"></line>
                    </svg>
                </span>
                <div class="flex-grow-1">
                    <span class="badge rounded-pill bg-white text-success mb-2">Suivi</span>
                    <h1 class="h3 mb-2">Tournées organisées</h1>
                    <p class="mb-0 text-white-50" style="max-width: 640px;">
                        Retrouvez toutes les tournées créées : chauffeur, camionnette, chargement
                        et ordre de passage dans les dépôts.
                    </p>
                </div>
                <a href="{{ path('app_tournees') }}" class="btn btn-light btn-lg d-none d-lg-inline-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Organiser une tournée
                </a>
            </div>
        </section>

        {% include 'tournees/_tabs.html.twig' with { current: 'liste' } %}

        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="kpi">
                    <div class="tc-label mb-2">Tournées</div>
                    <div class="kpi-value">{{ stats.tournees }}</div>
                    <div class="kpi-sub">organisées</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="kpi">
                    <div class="tc-label mb-2">Paniers</div>
                    <div class="kpi-value">{{ stats.paniers }}</div>
                    <div class="kpi-sub">affectés aux tournées</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="kpi">
                    <div class="tc-label mb-2">Camionnettes</div>
                    <div class="kpi-value">{{ stats.vehicules }}</div>
                    <div class="kpi-sub">utilisées</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="kpi">
                    <div class="tc-label mb-2">Chauffeurs</div>
                    <div class="kpi-value">{{ stats.chauffeurs }}</div>
                    <div class="kpi-sub">mobilisés</div>
                </div>
            </div>
        </div>

        <div class="card tc-card mb-4">
            <div class="card-body p-3 p-lg-4">
                <form method="get" action="{{ path('app_tournees_liste') }}" class="row g-3 align-items-end">
                    <div class="col-md-5">
                        <label for="filtre-structure" class="form-label fw-semibold small">Structure</label>
                        <select id="filtre-structure" name="structure" class="form-select">
                            <option value="">Toutes les structures</option>
                            {% for structure in structures %}
                                <option value="{{ structure.id }}" {{ filtres.structure == structure.id ? 'selected' }}>
                                    {{ structure.nomCommercial ?? 'Structure sans nom' }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="filtre-date" class="form-label fw-semibold small">Date de livraison</label>
                        <input id="filtre-date" type="date" name="date" class="form-control" value="{{ filtres.date ?? '' }}">
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-tc flex-grow-1">Filtrer</button>
                        {% if filtres.structure or filtres.date %}
                            <a href="{{ path('app_tournees_liste') }}" class="btn btn-tc-outline">Réinitialiser</a>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>

        {% if tournees is empty %}
            <div class="card tc-card">
                <div class="card-body p-4 p-lg-5 text-center">
                    <span class="empty-illustration mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="6" cy="19" r="3"></circle>
                            <path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"></path>
                            <circle cx="18" cy="5" r="3"></circle>
                        </svg>
                    </span>
                    {% if filtres.structure or filtres.date %}
                        <h2 class="h5 mb-2">Aucune tournée pour ces filtres</h2>
                        <p class="text-muted mb-3">Essaie une autre structure ou une autre date.</p>
                        <a href="{{ path('app_tournees_liste') }}" class="btn btn-tc-outline">Voir toutes les tournées</a>
                    {% else %}
                        <h2 class="h5 mb-2">Aucune tournée organisée</h2>
                        <p class="text-muted mb-3">
                            Les tournées créées depuis l’outil d’organisation apparaîtront ici.
                        </p>
                        <a href="{{ path('app_tournees') }}" class="btn btn-tc">Organiser une tournée</a>
                    {% endif %}
                </div>
            </div>
        {% else %}
            {% for dateCle, lignes in groupes %}
                <div class="date-separator">
                    <h2 class="h6 fw-bold mb-0 text-dark">{{ dateCle|date('d/m/Y') }}</h2>
                    <span class="badge rounded-pill">{{ lignes|length }} tournée{{ lignes|length > 1 ? 's' : '' }}</span>
                </div>

                <div class="row g-3">
                    {% for tournee in lignes %}
                        {% set taux = tournee.taux %}
                        {% set barre = taux >= 90 ? 'bg-success' : (taux >= 50 ? 'bg-success' : 'bg-warning') %}
                        {% set statut_classes = {
                            'planifiee': 'text-bg-warning',
                            'en_cours': 'text-bg-info',
                            'livree': 'text-bg-success',
                            'annulee': 'text-bg-danger'
                        } %}
                        <div class="col-xl-6">
                            <div class="tournee-card p-4">
                                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                    <div>
                                        <div class="tc-label">Tournée #{{ tournee.tournee_id }}</div>
                                        <div class="fw-bold text-dark mb-1">{{ tournee.code ?? 'Sans code' }}</div>
                                        <div class="text-muted small">{{ tournee.nom ?? 'Tournée sans nom' }}</div>
                                    </div>
                                    <div class="text-end">
                                        <span class="vehicle-plate">{{ tournee.vehicule ?? 'Sans véhicule' }}</span>
                                        <div class="mt-2">
                                            <span class="badge {{ statut_classes[tournee.statut] ?? 'text-bg-light' }}">
                                                {{ tournee.statut }}
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row g-2 small mb-3">
                                    <div class="col-6">
                                        <div class="tc-label">Chauffeur</div>
                                        <div class="fw-semibold">{{ tournee.chauffeur }}</div>
                                    </div>
                                    <div class="col-6">
                                        <div class="tc-label">Structure</div>
                                        <div class="fw-semibold">{{ tournee.structure ?? '—' }}</div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Chargement</span>
                                    <span class="fw-semibold">{{ tournee.charge }} / {{ tournee.capacite }} paniers</span>
                                </div>
                                <div class="progress progress-thin mb-3">
                                    <div class="progress-bar {{ barre }}" style="width: {{ min(100, taux) }}%"></div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="tc-label mb-0">Itinéraire</div>
                                    <span class="badge badge-soft">{{ tournee.etapes|length }} étape{{ tournee.etapes|length > 1 ? 's' : '' }}</span>
                                </div>

                                {% if tournee.etapes is empty %}
                                    <p class="text-muted small mb-0">Aucune étape enregistrée.</p>
                                {% else %}
                                    {% for etape in tournee.etapes %}
                                        <div class="step-line">
                                            <span class="step-index">{{ etape.ordre }}</span>
                                            <div class="flex-grow-1">
                                                <div class="fw-semibold small">{{ etape.depot }}</div>
                                                {% if etape.ville %}
                                                    <div class="text-muted small">{{ etape.ville }}</div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
