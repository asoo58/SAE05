{% extends 'base.html.twig' %}

{% block title %}Itinéraires des tournées{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="{{ asset('css/tournees.css') }}">
{% endblock %}

{% block body %}
    <div class="tournees-page tournees-page--itineraire">
        <section class="tournees-hero rounded-4 p-4 p-lg-5 mb-4">
            <div class="d-flex align-items-start gap-3 position-relative" style="z-index: 1;">
                <span class="hero-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                        <line x1="8" y1="2" x2="8" y2="18"></line>
                        <line x1="16" y1="6" x2="16" y2="22"></line>
                    </svg>
                </span>
                <div class="flex-grow-1">
                    <span class="badge rounded-pill bg-white text-success mb-2">Réorganisation</span>
                    <h1 class="h3 mb-2">Itinéraires des tournées</h1>
                    <p class="mb-0 text-white-50" style="max-width: 660px;">
                        Visualise les points de dépôt tournée par tournée, change l’ordre de passage
                        ou déplace un dépôt vers une autre tournée.
                    </p>
                </div>
                <a href="{{ path('app_tournees') }}" class="btn btn-light btn-lg d-none d-lg-inline-flex align-items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Organiser une tournée
                </a>
            </div>
        </section>

        {% include 'tournees/_tabs.html.twig' with { current: 'itineraire' } %}

        <div class="card tc-card mb-4">
            <div class="card-body p-3 p-lg-4">
                <form method="get" action="{{ path('app_tournees_itineraire') }}" class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label for="filtre-structure" class="form-label fw-semibold small">Structure</label>
                        <select id="filtre-structure" name="structure" class="form-select">
                            <option value="">Toutes les structures</option>
                            {% for structure in structures %}
                                <option value="{{ structure.id }}" {{ filtres.structure == structure.id ? 'selected' }}>
                                    {{ structure.nomCommercial ?? 'Structure sans nom' }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6 d-flex gap-2">
                        <button type="submit" class="btn btn-tc">Afficher les itinéraires</button>
                        {% if filtres.structure %}
                            <a href="{{ path('app_tournees_itineraire') }}" class="btn btn-tc-outline">Réinitialiser</a>
                        {% endif %}
                    </div>
                </form>
            </div>
        </div>

        {% if tournees is empty %}
            <div class="card tc-card">
                <div class="card-body p-4 p-lg-5 text-center">
                    <span class="empty-illustration mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
                            <line x1="8" y1="2" x2="8" y2="18"></line>
                            <line x1="16" y1="6" x2="16" y2="22"></line>
                        </svg>
                    </span>
                    <h2 class="h5 mb-2">Aucune tournée à afficher</h2>
                    <p class="text-muted mb-3">
                        Crée d’abord une tournée depuis l’outil d’organisation ; elle apparaîtra ensuite ici.
                    </p>
                    <a href="{{ path('app_tournees') }}" class="btn btn-tc">Organiser une tournée</a>
                </div>
            </div>
        {% else %}
            <div class="row g-3">
                {% for tournee in tournees %}
                    <div class="col-12">
                        <div class="itineraire-card p-4" style="border-left-color: {{ tournee.couleur }};">
                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <span class="tournee-dot" style="background: {{ tournee.couleur }};"></span>
                                        <span class="tc-label">Tournée</span>
                                    </div>
                                    <h2 class="h5 fw-bold text-dark mb-1">{{ tournee.code ?? 'Sans identifiant' }}</h2>
                                    <div class="text-muted small">
                                        {{ tournee.nom ?? 'Tournée sans nom' }}
                                        {% if tournee.structure %} · {{ tournee.structure }}{% endif %}
                                    </div>
                                </div>
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <span class="chip">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="12" cy="7" r="4"></circle>
                                        </svg>
                                        Préparation : {{ tournee.jour_preparation ?? 'non défini' }}
                                    </span>
                                    <span class="chip">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="1" y="3" width="15" height="13"></rect>
                                            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                                            <circle cx="5.5" cy="18.5" r="2.5"></circle>
                                            <circle cx="18.5" cy="18.5" r="2.5"></circle>
                                        </svg>
                                        Livraison : {{ tournee.jour_livraison ?? 'non défini' }}
                                    </span>
                                    <span class="badge rounded-pill text-bg-light">{{ tournee.etapes|length }} étape{{ tournee.etapes|length > 1 ? 's' : '' }}</span>
                                </div>
                            </div>

                            <details class="settings-details mb-3">
                                <summary class="settings-toggle">Modifier l’identifiant, les jours et la couleur</summary>
                                    <form method="post" action="{{ path('app_tournees_itineraire_modifier', { id: tournee.id }) }}" class="row g-2 align-items-end p-3 rounded-3 mt-2" style="background: #f7faf8; border: 1px solid #e6ece8;">
                                        <input type="hidden" name="structure" value="{{ filtres.structure ?? '' }}">
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold" for="code-{{ tournee.id }}">Identifiant</label>
                                            <input id="code-{{ tournee.id }}" type="text" name="code_tournee" class="form-control form-control-sm" maxlength="20" required value="{{ tournee.code }}">
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-semibold" for="nom-{{ tournee.id }}">Nom</label>
                                            <input id="nom-{{ tournee.id }}" type="text" name="nom" class="form-control form-control-sm" maxlength="100" value="{{ tournee.nom }}">
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold" for="prep-{{ tournee.id }}">Jour de préparation</label>
                                            <select id="prep-{{ tournee.id }}" name="jour_preparation" class="form-select form-select-sm">
                                                <option value="">—</option>
                                                {% for jour in jours %}
                                                    <option value="{{ jour }}" {{ tournee.jour_preparation == jour ? 'selected' }}>{{ jour }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="form-label small fw-semibold" for="livr-{{ tournee.id }}">Jour de livraison</label>
                                            <select id="livr-{{ tournee.id }}" name="jour_livraison" class="form-select form-select-sm">
                                                <option value="">—</option>
                                                {% for jour in jours %}
                                                    <option value="{{ jour }}" {{ tournee.jour_livraison == jour ? 'selected' }}>{{ jour }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="col-md-1">
                                            <label class="form-label small fw-semibold" for="couleur-{{ tournee.id }}">Couleur</label>
                                            <input id="couleur-{{ tournee.id }}" type="color" name="couleur" class="form-control form-control-color form-control-sm" value="{{ tournee.couleur }}" title="Couleur de la tournée">
                                        </div>
                                        <div class="col-md-1">
                                            <button type="submit" class="btn btn-tc btn-sm w-100">OK</button>
                                        </div>
                                    </form>
                            </details>

                            {% if tournee.etapes is empty %}
                                <div class="alert alert-light border mb-0 small">
                                    Cette tournée ne contient encore aucun point de dépôt.
                                </div>
                            {% else %}
                                <div class="tc-label mb-2">Ordre de livraison</div>
                                {% for etape in tournee.etapes %}
                                    <div class="step-row">
                                        <span class="step-index">{{ etape.ordre }}</span>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold">{{ etape.nom }}</div>
                                            <div class="step-meta">
                                                {% if etape.adresse %}{{ etape.adresse }}{% endif %}
                                                {% if etape.code_postal or etape.ville %}
                                                    — {{ etape.code_postal }} {{ etape.ville }}
                                                {% endif %}
                                            </div>
                                            <div class="step-meta">
                                                {% if etape.capacite is not null %}Capacité : {{ etape.capacite }} paniers{% endif %}
                                                {% if etape.referent %} · Référent : {{ etape.referent }}{% endif %}
                                                {% if etape.referent_tel %} ({{ etape.referent_tel }}){% endif %}
                                            </div>
                                        </div>
                                        <div class="step-actions">
                                            <form method="post" action="{{ path('app_tournees_itineraire_deplacer', { id: tournee.id }) }}">
                                                <input type="hidden" name="structure" value="{{ filtres.structure ?? '' }}">
                                                <input type="hidden" name="depot" value="{{ etape.depot_id }}">
                                                <input type="hidden" name="direction" value="haut">
                                                <button type="submit" class="btn-move" title="Monter" {{ loop.first ? 'disabled' : '' }} aria-label="Monter {{ etape.nom }}">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <polyline points="18 15 12 9 6 15"></polyline>
                                                    </svg>
                                                </button>
                                            </form>
                                            <form method="post" action="{{ path('app_tournees_itineraire_deplacer', { id: tournee.id }) }}">
                                                <input type="hidden" name="structure" value="{{ filtres.structure ?? '' }}">
                                                <input type="hidden" name="depot" value="{{ etape.depot_id }}">
                                                <input type="hidden" name="direction" value="bas">
                                                <button type="submit" class="btn-move" title="Descendre" {{ loop.last ? 'disabled' : '' }} aria-label="Descendre {{ etape.nom }}">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <polyline points="6 9 12 15 18 9"></polyline>
                                                    </svg>
                                                </button>
                                            </form>

                                            {% set autres = cibles_par_structure[tournee.structure_id] ?? [] %}
                                            {% if autres|length > 1 %}
                                                <form method="post" action="{{ path('app_tournees_itineraire_transferer', { id: tournee.id }) }}" class="transfer-form">
                                                    <input type="hidden" name="structure" value="{{ filtres.structure ?? '' }}">
                                                    <input type="hidden" name="depot" value="{{ etape.depot_id }}">
                                                    <select name="cible" class="form-select form-select-sm" aria-label="Tournée cible pour {{ etape.nom }}">
                                                        <option value="">Déplacer vers…</option>
                                                        {% for autre in autres %}
                                                            {% if autre.id != tournee.id %}
                                                                <option value="{{ autre.id }}">{{ autre.code }}</option>
                                                            {% endif %}
                                                        {% endfor %}
                                                    </select>
                                                    <button type="submit" class="btn btn-tc-outline btn-sm">OK</button>
                                                </form>
                                            {% endif %}

                                            <form method="post" action="{{ path('app_tournees_itineraire_retirer', { id: tournee.id }) }}">
                                                <input type="hidden" name="structure" value="{{ filtres.structure ?? '' }}">
                                                <input type="hidden" name="depot" value="{{ etape.depot_id }}">
                                                <button type="submit" class="btn-move is-danger" title="Retirer de la tournée" aria-label="Retirer {{ etape.nom }} de la tournée">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                        <polyline points="3 6 5 6 21 6"></polyline>
                                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
                                                        <path d="M10 11v6"></path>
                                                        <path d="M14 11v6"></path>
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}

                            {% set deja_ids = tournee.etapes|map(etape => etape.depot_id) %}
                            {% set disponibles = (depots_par_structure[tournee.structure_id] ?? [])|filter(depot => depot.id not in deja_ids) %}
                            {% if disponibles is not empty %}
                                <div class="add-step mt-3 pt-3">
                                    <form method="post" action="{{ path('app_tournees_itineraire_ajouter', { id: tournee.id }) }}" class="transfer-form">
                                        <input type="hidden" name="structure" value="{{ filtres.structure ?? '' }}">
                                        <label class="tc-label mb-0 me-1" for="ajout-{{ tournee.id }}">Ajouter un dépôt</label>
                                        <select id="ajout-{{ tournee.id }}" name="depot" class="form-select form-select-sm" aria-label="Dépôt à ajouter à la tournée {{ tournee.code }}">
                                            {% for depot in disponibles %}
                                                <option value="{{ depot.id }}">{{ depot.nom }}{% if depot.ville %} — {{ depot.ville }}{% endif %}</option>
                                            {% endfor %}
                                        </select>
                                        <button type="submit" class="btn btn-tc-outline btn-sm">Ajouter</button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
