<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Jardin de cocagne{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="stylesheet" href="{{ asset('css/admin.css') }}">
    <link rel="stylesheet" href="{{ asset('css/utilisateur.css') }}">
    <link rel="icon" href="{{ asset('images/logo-1.svg') }}">

    {# En local #}
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/tabler.min.css') }}">

    {% block stylesheets %}{% endblock %}
</head>

<body class="my-page">

{% block header %}
    {# Dans base.html.twig, remplacer la balise <header> existante par : #}
<header>
    <div class="bas">
        <div class="logo">
            <a href="{{ path('app_home') }}">
                <img src="{{ asset('images/Jardins_Thaon - Simple.svg') }}" width="70" alt="logo">
            </a>
            <div class="logo-text">
                <h1>Les Jardins de Cocagne</h1>
                <p>Thaon-les-Vosges</p>
            </div>
        </div>
    </div>

    {# --- Navigation principale --- #}
    <nav class="navigation-principale">
        <a href="{{ path('app_home') }}" class="nav-lien actif">Accueil</a>
        <a href="#depots" class="nav-lien">Dépôts & Tournées</a>
        <a href="#recettes" class="nav-lien">Recettes</a>
        <a href="#contact" class="nav-lien">Contact</a>
    </nav>

    {# --- Espace Compte / Connexion --- #}
    <div class="actions-header">
        {% if app.user %}
            <span class="nomconnex">{{ app.user.userIdentifier }}</span>
            <a href="{{ path('app_logout') }}" class="btn btn-sm">Déconnexion</a>
        {% else %}
            <a href="#" class="btn-modern">
                <span>Connexion</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path><polyline points="10 17 15 12 10 7"></polyline><line x1="15" y1="12" x2="3" y2="12"></line></svg>
            </a>
        {% endif %}
    </div>
</header>    
{% endblock %}

<div class="container">
    <div class="container mt-3">
        {# Messages Flash #}
        {% for message in app.flashes('register_success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('warning') %}
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}
        {% endblock %}
    </div>
</div>

{% block footer %}
    <footer>
